digraph simple {
  graph [rankdir=LR, fontname="Inter", nodesep=0.3, ranksep=0.35, bgcolor="white", pad=0.2, newrank=true, splines=spline];
  node  [fontname="Inter", fontsize=11, color="#52514e", penwidth=1.1, style=filled, fillcolor="white",
         fontcolor="#0b0b0b", margin="0.12,0.06"];
  edge  [color="#52514e", penwidth=1.0, arrowsize=0.7, fontname="Inter", fontsize=10, fontcolor="#52514e"];

  data   [shape=polygon, sides=4, skew=0.18, fixedsize=true, width=1.6, height=0.7, fillcolor="#f1f0ec", label="Public apatite\ndata"];
  clean  [shape=box, label="Compile\nand clean"];
  feat   [shape=box, label="Features\nREE anomalies;\nSr, Ba, Mg"];
  isab   [shape=diamond, label="Abiotic?", fixedsize=true, width=1.15, height=0.8];
  ref    [shape=cylinder, fillcolor="#e9e8e3", label="Abiotic\nreference"];
  test   [shape=box, style="rounded,filled,dashed", label="Test\nsamples"];

  data -> clean -> feat -> isab;
  isab -> ref  [label="yes"];
  isab -> test [label="no"];
  { rank=same; ref; test; }

  subgraph cluster_m1 {
    label=<<b>Method 1: GMM baseline scoring</b>>; labeljust="l"; fontname="Inter"; fontsize=11; fontcolor="#184f95";
    style="rounded,filled"; fillcolor="#eef4fc"; color="#2a78d6";
    gmm   [shape=box, label="Score vs.\nreference"];
    unus  [shape=diamond, label="Unusual?", fixedsize=true, width=1.2, height=0.8];
    dir   [shape=diamond, label="Known abiotic\ndirection?", fixedsize=true, width=1.6, height=0.95];
    typ   [shape=box, style="rounded,filled", label="Typical"];
    expl  [shape=box, style="rounded,filled", label="Explained"];
    unex  [shape=box, style="rounded,filled", fillcolor="#fde7dc", color="#d95926", label="Unexplained"];
  }
  subgraph cluster_m2 {
    label=<<b>Method 2: KDE density check</b>>; labeljust="l"; fontname="Inter"; fontsize=11; fontcolor="#a8401a";
    style="rounded,filled"; fillcolor="#fdf1eb"; color="#eb6834";
    kde   [shape=box, label="Share of density\nfrom reference"];
    low   [shape=diamond, label="Below\nexpected?", fixedsize=true, width=1.3, height=0.85];
    mixed [shape=box, style="rounded,filled", label="Mixed with\nreference"];
    own   [shape=box, style="rounded,filled", label="Distinct\ngroup"];
  }

  ref -> gmm:w [minlen=2];  test -> gmm:w [style=dashed, minlen=2];
  ref -> kde:w [minlen=2];  test -> kde:w [style=dashed, minlen=2];
  gmm -> unus;
  unus -> typ [label="no"];
  unus -> dir [label="yes"];
  dir -> expl [label="yes"];
  dir -> unex [label="no"];
  kde -> low;
  low -> mixed [label="no"];
  low -> own   [label="yes"];
}
